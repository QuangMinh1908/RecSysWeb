# =======================================================
# Shopee Temporal RecSys Web Project - .gitignore
# =======================================================

# --- Environment, Secrets & PIDs ---
.env
.env.*
!.env.example
*.pid

# --- Logs & Temp ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
torch_install.log

# --- Database & Datasets (Managed via Hugging Face CLI) ---
database/
data/
dataset/
*.sql
*.csv
*.tsv
*.parquet
*.dump
*.db
*.sqlite3

# --- 1-frontend-web (Node / React / Vite) ---
**/node_modules/
**/dist/
**/.vite/

# --- 2-core-backend (Java / Maven / Spring Boot) ---
**/target/
*.class
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar

# --- 3-model-service (Python / PyTorch / Conda) ---
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# --- IDE & OS Cache ---
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
